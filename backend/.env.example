PORT=5000
NODE_ENV=development

# Database configuration (Supabase PostgreSQL)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=

# Caching & Queue (Redis)
# Format: rediss://default:[password]@[host]:[port]
REDIS_URL=

# Token Encryption Secret Keys (Generate strong random strings)
JWT_SECRET=
REFRESH_SECRET=

# Frontend Application URL (e.g., https://your-vercel-domain.vercel.app)
# Use a comma-separated list for multiple origins
FRONTEND_URL=

# Email configuration (Brevo HTTP API is used)
BREVO_API_KEY="your-brevo-api-key"
SMTP_FROM="no-reply@yourdomain.com"
SMTP_USER="your-verified-email@domain.com"

# Optional: Judge0 API Integration (leaves empty to fallback to Piston)
# JUDGE0_API_URL="https://judge0-extra-clean.p.rapidapi.com"
# JUDGE0_API_KEY="your-rapid-api-key"
