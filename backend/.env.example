PORT=5000
NODE_ENV=development

# Database configuration (Supabase PostgreSQL)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=

# Caching & Queue (Redis)
# Format: rediss://default:[password]@[host]:[port]
REDIS_URL=

# Token Encryption Secret Keys (Generate strong random strings)
JWT_SECRET=
REFRESH_SECRET=

# Frontend Application URL (e.g., https://your-vercel-domain.vercel.app)
# Use a comma-separated list for multiple origins
FRONTEND_URL=

# Brevo Email API Key
BREVO_API_KEY=

# Optional: Judge0 API Integration (leaves empty to fallback to Piston)
# JUDGE0_API_URL="https://judge0-extra-clean.p.rapidapi.com"
# JUDGE0_API_KEY="your-rapid-api-key"
