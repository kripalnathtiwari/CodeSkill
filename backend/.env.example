# ==============================================================================
# CodeSkill Backend — API & Worker Environment Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# API & Worker services MUST use the PgBouncer pooled connection string (port 6543).
# Set connection_limit=10 on API service, connection_limit=5 on Worker service.
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
# Direct non-pooled URL (port 5432) is ONLY for `prisma migrate deploy` / `prisma db push`
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# Redis Separation (Cache vs BullMQ Queues)
# Keep Cache Redis separate from Queue Redis (noeviction required for BullMQ!).
# ------------------------------------------------------------------------------
# Upstash Cache Redis (sessions, HTTP cache, leaderboards)
REDIS_URL="rediss://default:[password]@[upstash-host]:6379"
# Dedicated Queue Redis (Railway Redis add-on recommended with maxmemory-policy=noeviction)
QUEUE_REDIS_URL="redis://default:[password]@[railway-redis-host]:6379"
BULLMQ_PREFIX="codeskill:bull"
REDIS_TLS_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# BullMQ Worker Tuning (Upstash-safe polling defaults)
# ------------------------------------------------------------------------------
BULLMQ_DRAIN_DELAY_SEC=20
BULLMQ_STALLED_INTERVAL_MS=120000
BULLMQ_LOCK_DURATION_MS=60000
JUDGE0_CONCURRENCY=5
EMAIL_WORKER_CONCURRENCY=5
EXAM_WORKER_CONCURRENCY=5
PERFORMANCE_WORKER_CONCURRENCY=4
FILE_WORKER_CONCURRENCY=2
NOTIFICATION_WORKER_CONCURRENCY=8
SCHEDULER_TIMEZONE="UTC"
DAILY_REPORT_CRON="0 1 * * *"
WEEKLY_REPORT_CRON="0 2 * * 1"

# ------------------------------------------------------------------------------
# Auth & CORS
# ------------------------------------------------------------------------------
JWT_SECRET=""
REFRESH_SECRET=""
SESSION_L1_TTL_MS=15000
FRONTEND_URL="https://frontend-react-ecru-six.vercel.app"

# ------------------------------------------------------------------------------
# Email (Brevo HTTP API v3)
# ------------------------------------------------------------------------------
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="no-reply@codeskill.in"
BREVO_SENDER_NAME="CodeSkill LMS"
BREVO_LIMITER_MAX=10
BREVO_LIMITER_DURATION_MS=1000
OTP_TTL_MS=300000

# ------------------------------------------------------------------------------
# Code Execution (Judge0 CE / RapidAPI)
# ------------------------------------------------------------------------------
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""
JUDGE0_POLL_INTERVAL_MS=800
JUDGE0_MAX_POLL_WAIT_MS=25000
JUDGE0_HTTP_TIMEOUT_MS=12000

# ------------------------------------------------------------------------------
# Object Storage (Cloudflare R2 S3-Compatible API)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="codeskill-files"
