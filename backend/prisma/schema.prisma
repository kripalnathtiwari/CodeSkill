generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String               @id @default(uuid()) @db.Uuid
  email                 String               @unique
  phoneNumber           String?
  passwordHash          String?
  role                  String               @default("STUDENT")
  status                String               @default("ACTIVE")
  isVerified            String?
  forgotPasswordToken   String?
  lastLoginAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  achievements          Achievement[]
  bookmarks             Bookmark[]
  certificates          Certificate[]
  comments              Comment[]
  contestParticipations ContestParticipant[]
  coursesCreated        Course[]             @relation("CourseInstructor")
  sessions              DeviceSession[]
  discussions           Discussion[]
  enrollments           Enrollment[]
  notifications         Notification[]
  orders                Order[]
  payments              Payment[]
  profile               Profile?
  reviews               Review[]
  submissions           Submission[]
  testsCreated          Test[]               @relation("TestCreator")
  testAttempts          TestAttempt[]
  testSnapshots         TestSnapshot[]
  activityLogs          UserActivityLog[]
  resumes               Resume[]
  jobDescriptions       JobDescription[]
  atsAnalyses           AtsAnalysis[]
  adminNotes            Note[]               @relation("AdminNotes")

  @@index([email])
  @@index([role])
  @@index([status])
}

model Profile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  firstName    String
  lastName     String
  avatarUrl    String?
  bio          String?
  skills       String   @default("[]")
  codingRating Int      @default(1500)
  totalSolved  Int      @default(0)
  resumeUrl    String?
  dailyStreak  Int      @default(0)
  xp           Int      @default(0)
  level        Int      @default(1)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastActive])
}

model UserActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  action    String
  ipAddress String?
  device    String?
  browser   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Category {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  slug          String        @unique
  createdAt     DateTime      @default(now())
  courses       Course[]
  subcategories Subcategory[]
}

model Subcategory {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @db.Uuid
  name       String
  slug       String   @unique
  createdAt  DateTime @default(now())
  courses    Course[]
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Course {
  id                   String        @id @default(uuid()) @db.Uuid
  title                String
  slug                 String        @unique
  categoryId           String?       @db.Uuid
  subcategoryId        String?       @db.Uuid
  seoTitle             String?
  seoDescription       String?
  thumbnailUrl         String?
  previewVideoUrl      String?
  description          String
  learningOutcomes     String        @default("[]")
  requirements         String        @default("[]")
  targetAudience       String        @default("[]")
  difficultyLevel      String        @default("BEGINNER")
  language             String        @default("English")
  price                Float         @default(0.0)
  discountPrice        Float?
  visibility           String        @default("PUBLIC")
  publishStatus        String        @default("DRAFT")
  duration             Int           @default(0)
  instructorId         String        @db.Uuid
  tags                 String        @default("[]")
  certificateAvailable Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?
  bookmarks            Bookmark[]
  certificates         Certificate[]
  category             Category?     @relation(fields: [categoryId], references: [id])
  instructor           User          @relation("CourseInstructor", fields: [instructorId], references: [id])
  subcategory          Subcategory?  @relation(fields: [subcategoryId], references: [id])
  enrollments          Enrollment[]
  reviews              Review[]
  sections             Section[]

  @@index([slug])
  @@index([publishStatus])
  @@index([categoryId])
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @db.Uuid
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons   Lesson[]
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([order])
}

model Lesson {
  id            String           @id @default(uuid()) @db.Uuid
  sectionId     String           @db.Uuid
  title         String
  type          String           @default("VIDEO")
  videoUrl      String?
  pdfUrl        String?
  content       String?
  order         Int              @default(0)
  isFreePreview Boolean          @default(false)
  duration      Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  progress      CourseProgress[]
  section       Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([order])
}

model Order {
  id             String       @id @default(uuid()) @db.Uuid
  orderNumber    String       @unique
  userId         String       @db.Uuid
  totalAmount    Float
  discountAmount Float        @default(0.0)
  taxAmount      Float        @default(0.0)
  currency       String       @default("INR")
  paymentStatus  String       @default("PENDING")
  invoiceNumber  String?      @unique
  status         String       @default("PENDING")
  refundStatus   String?
  couponCode     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  enrollments    Enrollment[]
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id              String    @id @default(uuid()) @db.Uuid
  orderId         String?   @db.Uuid
  userId          String    @db.Uuid
  transactionId   String    @unique
  gateway         String    @default("STRIPE")
  method          String?
  amount          Float
  currency        String    @default("INR")
  plan            String    @default("FREE")
  status          String    @default("PENDING")
  gatewayResponse String?
  refundDetails   String?
  couponCode      String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orderId])
  @@index([createdAt])
}

model Enrollment {
  id                 String           @id @default(uuid()) @db.Uuid
  studentId          String           @db.Uuid
  courseId           String           @db.Uuid
  orderId            String?          @db.Uuid
  expiryDate         DateTime?
  isLifetime         Boolean          @default(true)
  status             String           @default("ACTIVE")
  progressPercentage Float            @default(0.0)
  lastAccessedAt     DateTime?
  completedAt        DateTime?
  certificateIssued  Boolean          @default(false)
  source             String?
  couponUsed         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  progressRecords    CourseProgress[]
  course             Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order              Order?           @relation(fields: [orderId], references: [id])
  student            User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([status])
}

model CourseProgress {
  id                  String     @id @default(uuid()) @db.Uuid
  enrollmentId        String     @db.Uuid
  lessonId            String     @db.Uuid
  watchPercentage     Float      @default(0.0)
  lastWatchedPosition Int        @default(0)
  isCompleted         Boolean    @default(false)
  completedAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  enrollment          Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson              Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model Review {
  id             String   @id @default(uuid()) @db.Uuid
  courseId       String   @db.Uuid
  userId         String   @db.Uuid
  rating         Int      @default(5)
  reviewText     String?
  likes          Int      @default(0)
  approvalStatus String   @default("APPROVED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([userId])
  @@index([createdAt])
}

model Coupon {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  discountType  String    @default("PERCENTAGE")
  discountValue Float
  maxDiscount   Float?
  expiryDate    DateTime?
  usageLimit    Int?
  usedCount     Int       @default(0)
  userLimit     Int       @default(1)
  applicableTo  String    @default("ALL")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Question {
  id             String         @id @default(uuid()) @db.Uuid
  title          String
  slug           String         @unique
  difficulty     String         @default("EASY")
  type           String         @default("CODING")
  description    String
  constraints    String?
  examples       String         @default("[]")
  hints          String         @default("[]")
  editorial      String?
  starterCodes   String         @default("{}")
  timeLimit      Int            @default(2000)
  memoryLimit    Int            @default(256)
  tags           String         @default("[]")
  companies      String         @default("[]")
  likes          Int            @default(0)
  dislikes       Int            @default(0)
  acceptanceRate Float          @default(0.0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bookmarks      Bookmark[]
  discussions    Discussion[]
  mcqOptions     MCQ[]
  submissions    Submission[]
  testCases      TestCase[]
  tests          TestQuestion[]

  @@index([slug])
  @@index([difficulty])
  @@index([type])
  @@index([createdAt])
  @@index([difficulty, createdAt(sort: Desc), id(sort: Desc)])
  @@index([type, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model TestCase {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  input      String
  output     String
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model MCQ {
  id             String   @id @default(uuid()) @db.Uuid
  questionId     String   @db.Uuid
  options        String   @default("[]")
  correctAnswers String   @default("[]")
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Submission {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  questionId    String       @db.Uuid
  code          String
  language      String
  status        String       @default("PENDING")
  runtime       Int?
  memory        Int?
  compileOutput String?
  errorOutput   String?
  passedCount   Int          @default(0)
  totalCount    Int          @default(0)
  testAttemptId String?      @db.Uuid
  createdAt     DateTime     @default(now())
  compilerJob   CompilerJob?
  question      Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  testAttempt   TestAttempt? @relation(fields: [testAttemptId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@index([status])
  @@index([createdAt])
}

model CompilerJob {
  id           String     @id @default(uuid()) @db.Uuid
  submissionId String     @unique @db.Uuid
  status       String     @default("QUEUED")
  judge0Id     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Test {
  id                 String         @id @default(uuid()) @db.Uuid
  title              String
  description        String?
  duration           Int
  accessType         String         @default("PUBLIC")
  passcode           String?
  isPublished        Boolean        @default(false)
  startTime          DateTime?
  endTime            DateTime?
  creatorId          String         @db.Uuid
  randomQuestionPool Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  bookmarks          Bookmark[]
  certificates       Certificate[]
  creator            User           @relation("TestCreator", fields: [creatorId], references: [id])
  attempts           TestAttempt[]
  questions          TestQuestion[]

  @@index([isPublished])
  @@index([creatorId])
}

model TestQuestion {
  testId     String   @db.Uuid
  questionId String   @db.Uuid
  section    String   @default("General")
  order      Int      @default(0)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([testId, questionId])
}

model TestAttempt {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  testId      String       @db.Uuid
  score       Int          @default(0)
  status      String       @default("STARTED")
  startTime   DateTime     @default(now())
  endTime     DateTime?
  createdAt   DateTime     @default(now())
  submissions Submission[]
  test        Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([testId])
  @@index([status])
}

model TestSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  testId     String
  imageUrl   String
  capturedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contest {
  id           String               @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  startTime    DateTime
  endTime      DateTime
  rating       Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  participants ContestParticipant[]
}

model ContestParticipant {
  id           String   @id @default(uuid()) @db.Uuid
  contestId    String   @db.Uuid
  userId       String   @db.Uuid
  score        Int      @default(0)
  penalty      Int      @default(0)
  rank         Int?
  ratingChange Int?
  registeredAt DateTime @default(now())
  contest      Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
}

model Certificate {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  testId     String?  @db.Uuid
  courseId   String?  @db.Uuid
  uniqueCode String   @unique
  pdfUrl     String
  qrCodeUrl  String
  issuedAt   DateTime @default(now())
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  test       Test?    @relation(fields: [testId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([testId])
}

model Bookmark {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  questionId String?   @db.Uuid
  testId     String?   @db.Uuid
  courseId   String?   @db.Uuid
  createdAt  DateTime  @default(now())
  course     Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  test       Test?     @relation(fields: [testId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@unique([userId, testId])
  @@unique([userId, courseId])
  @@index([userId])
}

model Discussion {
  id         String    @id @default(uuid()) @db.Uuid
  questionId String    @db.Uuid
  userId     String    @db.Uuid
  title      String
  content    String
  likes      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  comments   Comment[]
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([userId])
}

model Comment {
  id           String     @id @default(uuid()) @db.Uuid
  discussionId String     @db.Uuid
  userId       String     @db.Uuid
  content      String
  parentId     String?    @db.Uuid
  likes        Int        @default(0)
  createdAt    DateTime   @default(now())
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parent       Comment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]  @relation("CommentReplies")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([parentId])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Achievement {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  badgeName  String
  xpEarned   Int
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// Admin Data Models
// ==========================================

model CollegeCollection {
  id           String   @id @default(uuid()) @db.Uuid
  collegeEmail String
  collegeName  String?
  category     String
  uploadedAt   DateTime @default(now())
  
  students     CollegeStudent[]

  @@index([category])
}

model CollegeStudent {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @db.Uuid
  collection   CollegeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  name         String
  email        String
  phone        String?
  regNum       String?

  @@index([collectionId])
  @@index([email])
}

model CollegeInstitution {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  adminEmail   String?
  createdAt    DateTime @default(now())
  
  tutors       CollegeTutor[]
}

model CollegeTutor {
  id             String   @id @default(uuid()) @db.Uuid
  institutionId  String   @db.Uuid
  institution    CollegeInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  
  name           String
  phone          String
  domain         String
  joiningDate    String
  email          String
  section        String?
  trainerId      String?  @unique

  @@index([institutionId])
  @@index([email])
}

model CollegeCourseCategory {
  id           String   @id @default(uuid()) @db.Uuid
  collegeName  String
  collegeEmail String?
  courseName   String
  description  String?
  createdAt    DateTime @default(now())

  classes      CollegeCourseClass[]
  instructors  CollegeCourseInstructor[]
  students     CollegeCourseStudent[]

  @@index([collegeName])
  @@index([courseName])
}

model CollegeCourseClass {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @db.Uuid
  category     CollegeCourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  className    String
  description  String?
  createdAt    DateTime @default(now())

  instructors  CollegeCourseInstructor[]
  students     CollegeCourseStudent[]

  @@index([categoryId])
  @@index([className])
}

model CollegeCourseInstructor {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @db.Uuid
  category     CollegeCourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  classId      String?  @db.Uuid
  courseClass  CollegeCourseClass? @relation(fields: [classId], references: [id], onDelete: SetNull)

  name         String
  email        String
  phone        String?
  domain       String?
  trainerId    String?

  @@index([categoryId])
  @@index([classId])
  @@index([email])
}

model CollegeCourseStudent {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @db.Uuid
  category     CollegeCourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  classId      String?  @db.Uuid
  courseClass  CollegeCourseClass? @relation(fields: [classId], references: [id], onDelete: SetNull)

  name         String
  email        String
  regNum       String?
  phone        String?

  @@index([categoryId])
  @@index([classId])
  @@index([email])
}

model AptitudeProblem {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  description   String
  topic         String   @default("General Aptitude")
  difficulty    String   @default("Medium")
  options       String   @default("[]")
  correctAnswer String
  explanation   String?
  createdAt     DateTime @default(now())

  @@index([topic])
  @@index([difficulty])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model ArchiveRecord {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String
  originalId  String
  data        String   // JSON payload of the deleted record
  deletedBy   String?  @db.Uuid // ID of the user who deleted it
  deletedAt   DateTime @default(now())
  status      String   @default("ARCHIVED") // "ARCHIVED" or "RESTORED"
}

// ==========================================
// ATS Resume Scanner Models
// ==========================================

model Resume {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  fileUrl        String?
  fileName       String
  extractedText  String?
  parsedData     Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses       AtsAnalysis[]

  @@index([userId])
}

model JobDescription {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  title             String?
  content           String
  extractedKeywords Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses          AtsAnalysis[]

  @@index([userId])
}

model AtsAnalysis {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @db.Uuid
  resumeId           String          @db.Uuid
  jobDescriptionId   String          @db.Uuid
  status             String          @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  overallScore       Int             @default(0)
  keywordMatchScore  Int             @default(0)
  semanticMatchScore Int             @default(0)
  formattingScore    Int             @default(0)
  experienceScore    Int             @default(0)
  grammarScore       Int             @default(0)
  matchedKeywords    Json?
  missingKeywords    Json?
  aiSuggestions      Json?
  formattingIssues   Json?
  errorMessage       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume             Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescription     JobDescription  @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resumeId])
  @@index([jobDescriptionId])
  @@index([createdAt])
}

model SampleCvTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  fileUrl      String
  imageUrl     String?
  redirectUrl  String?
  previewUrl   String?
  category     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JobSkillMap {
  id           String   @id @default(uuid()) @db.Uuid
  jobRole      String   @unique
  skills       Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProjectIdea {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String
  domain      String
  difficulty  String
  techStack   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String?  @db.Uuid
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin     User?    @relation("AdminNotes", fields: [adminId], references: [id], onDelete: SetNull)
}
