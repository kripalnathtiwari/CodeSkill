{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://codesklii-backend-production.up.railway.app/api/:match*"
    },
    {
      "source": "/public/:match*",
      "destination": "https://codesklii-backend-production.up.railway.app/public/:match*"
    },
    {
      "source": "/((?!sitemap\\.xml$|robots\\.txt$|favicon\\.svg$|icons\\.svg$|assets/|images/).*)",
      "destination": "/index.html"
    }
  ]
}
